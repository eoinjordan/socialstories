# Copy to .env.local for local dev; set the same keys in the Vercel dashboard.

# openssl rand -base64 32
AUTH_SECRET=

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local dev only. On Vercel, Auth.js derives this from the deployment URL.
# NEXTAUTH_URL=http://localhost:3000
